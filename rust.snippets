snippet snosak
	struct Osa_k {
	    spf: Vec<usize>,
	}
	
	impl Osa_k {
	    fn new(max_val: usize) -> Self {
	        let mut spf = (0..=max_val).collect_vec();
	        let mut i = 2;
	        while i * i <= max_val {
	            if spf[i] == i {
	                let mut j = i * i;
	                while j <= max_val {
	                    if spf[j] == j {
	                        spf[j] = i;
	                    }
	                    j += i;
	                }
	            }
	            i += 1;
	        }
	        Self { spf }
	    }
	    fn factorize(&self, mut x: usize) -> Vec<(usize, usize)> {
	        let mut res = vec![];
	        while x > 1 {
	            let p = self.spf[x];
	            let mut e = 0;
	            while x % p == 0 {
	                x /= p;
	                e += 1;
	            }
	            res.push((p, e));
	        }
	        res
	    }
	}

snippet snmultiset
	// https://zenn.dev/silva/articles/3af7df176849c2
	#[allow(dead_code)]
	mod procon_lib {
	    use std::{
	        borrow::Borrow,
	        collections::{
	            btree_map::{self},
	            BTreeMap,
	        },
	        ops::{Bound, RangeBounds},
	    };
	
	    #[derive(Debug, PartialEq, Clone)]
	    pub struct MultiSet<T> {
	        size: usize,
	        btree_map: BTreeMap<T, usize>,
	    }
	
	    impl<T: Ord> Default for MultiSet<T> {
	        fn default() -> Self {
	            Self::new()
	        }
	    }
	
	    impl<T: Ord> From<Vec<T>> for MultiSet<T> {
	        fn from(value: Vec<T>) -> Self {
	            let size = value.len();
	
	            let mut btree_map = BTreeMap::default();
	            for key in value {
	                *btree_map.entry(key).or_insert(0) += 1;
	            }
	
	            Self { size, btree_map }
	        }
	    }
	
	    impl<T: Ord> MultiSet<T> {
	        pub fn clear(&mut self) {
	            self.size = 0;
	            self.btree_map.clear();
	        }
	
	        pub fn contains<Q>(&self, value: &Q) -> bool
	        where
	            T: Borrow<Q>,
	            Q: Ord + ?Sized,
	        {
	            self.btree_map.contains_key(value)
	        }
	
	        pub fn insert(&mut self, value: T) {
	            self.size += 1;
	            *self.btree_map.entry(value).or_insert(0) += 1;
	        }
	
	        pub fn first(&self) -> Option<&T> {
	            if let Some((key, _)) = self.btree_map.iter().next() {
	                Some(key)
	            } else {
	                None
	            }
	        }
	
	        pub fn last(&self) -> Option<&T> {
	            if let Some((key, _)) = self.btree_map.iter().next_back() {
	                Some(key)
	            } else {
	                None
	            }
	        }
	
	        pub fn is_empty(&self) -> bool {
	            self.btree_map.is_empty()
	        }
	
	        pub fn len(&self) -> usize {
	            self.btree_map.len()
	        }
	
	        pub fn size(&self) -> usize {
	            self.size
	        }
	
	        pub fn marge(&mut self, other: &mut MultiSet<T>)
	        where
	            T: Clone,
	        {
	            self.size += other.size;
	
	            for (key, val) in other.btree_map.iter() {
	                if let Some(prev) = self.btree_map.get_mut(key) {
	                    *prev += *val;
	                } else {
	                    self.btree_map.insert(key.clone(), *val);
	                }
	            }
	        }
	
	        pub fn new() -> Self {
	            Self {
	                size: 0,
	                btree_map: BTreeMap::new(),
	            }
	        }
	
	        pub fn pop_first(&mut self) -> Option<T>
	        where
	            T: Clone,
	        {
	            if self.is_empty() {
	                None
	            } else {
	                self.size -= 1;
	
	                let first = self.first().unwrap().clone();
	                self.remove(&first);
	                Some(first)
	            }
	        }
	
	        pub fn pop_last(&mut self) -> Option<T>
	        where
	            T: Clone,
	        {
	            if self.is_empty() {
	                None
	            } else {
	                self.size -= 1;
	
	                let last = self.last().unwrap().clone();
	                self.remove(&last);
	                Some(last)
	            }
	        }
	
	        pub fn remove(&mut self, value: &T) -> bool
	        where
	            T: Clone,
	        {
	            self.btree_map.entry(value.clone()).and_modify(|e| *e -= 1);
	            if let Some(&cnt) = self.btree_map.get(&value) {
	                if cnt == 0 {
	                    self.btree_map.remove(&value);
	                }
	
	                self.size -= 1;
	                true
	            } else {
	                false
	            }
	        }
	
	        pub fn lower_bound<Q>(&self, bound: Bound<&Q>) -> Option<&T>
	        where
	            T: Borrow<Q>,
	            Q: Ord,
	        {
	            match bound {
	                Bound::Unbounded => unreachable!(),
	                _ => {
	                    if let Some((key, _)) = self.btree_map.range((bound, Bound::Unbounded)).next() {
	                        Some(key)
	                    } else {
	                        None
	                    }
	                }
	            }
	        }
	
	        pub fn upper_bound<Q>(&self, bound: Bound<&Q>) -> Option<&T>
	        where
	            T: Borrow<Q>,
	            Q: Ord,
	        {
	            match bound {
	                Bound::Unbounded => unreachable!(),
	                _ => {
	                    if let Some((key, _)) =
	                        self.btree_map.range((Bound::Unbounded, bound)).next_back()
	                    {
	                        Some(key)
	                    } else {
	                        None
	                    }
	                }
	            }
	        }
	
	        pub fn iter(&self) -> Iter<'_, T> {
	            Iter {
	                range: self.range(..),
	            }
	        }
	
	        pub fn range<U: ?Sized, R>(&self, range: R) -> Range<'_, T>
	        where
	            U: Ord,
	            T: Borrow<U> + Ord,
	            R: RangeBounds<U>,
	        {
	            Range {
	                last: None,
	                counter: 0,
	                range: self.btree_map.range(range),
	            }
	        }
	
	        pub fn count<Q>(&self, value: &Q) -> usize
	        where
	            T: Borrow<Q>,
	            Q: Ord,
	        {
	            if let Some(&cnt) = self.btree_map.get(value) {
	                cnt
	            } else {
	                0
	            }
	        }
	    }
	
	    #[derive(Debug, Clone, Default)]
	    pub struct Range<'a, T>
	    where
	        T: 'a,
	    {
	        last: Option<&'a T>,
	        counter: usize,
	        range: btree_map::Range<'a, T, usize>,
	    }
	
	    impl<'a, T> Iterator for Range<'a, T> {
	        type Item = &'a T;
	        fn next(&mut self) -> Option<Self::Item> {
	            if self.counter == 0 {
	                if let Some((elem, &cnt)) = self.range.next() {
	                    self.last = Some(elem);
	                    self.counter = cnt - 1;
	                    Some(elem)
	                } else {
	                    None
	                }
	            } else {
	                self.counter -= 1;
	                self.last
	            }
	        }
	    }
	
	    impl<'a, T> DoubleEndedIterator for Range<'a, T> {
	        fn next_back(&mut self) -> Option<Self::Item> {
	            if self.counter == 0 {
	                if let Some((elem, &cnt)) = self.range.next_back() {
	                    self.last = Some(elem);
	                    self.counter = cnt;
	                    Some(elem)
	                } else {
	                    None
	                }
	            } else {
	                self.counter -= 1;
	                self.last
	            }
	        }
	    }
	
	    #[derive(Clone, Debug, Default)]
	    pub struct Iter<'a, T>
	    where
	        T: 'a,
	    {
	        range: Range<'a, T>,
	    }
	
	    impl<'a, T> Iterator for Iter<'a, T> {
	        type Item = &'a T;
	        fn next(&mut self) -> Option<Self::Item> {
	            self.range.next()
	        }
	    }
	
	    impl<'a, T> DoubleEndedIterator for Iter<'a, T> {
	        fn next_back(&mut self) -> Option<Self::Item> {
	            self.range.next_back()
	        }
	    }
	}
	use procon_lib::MultiSet;

snippet sncombination
	pub struct Combinations {
	    fac: Vec<Mint>,
	    ifac: Vec<Mint>,
	}
	
	impl Combinations {
	    pub fn new() -> Self {
	        Self {
	            fac: vec![1.m()],
	            ifac: vec![1.m()],
	        }
	    }
	
	    pub fn ensure(&mut self, n: usize) {
	        if self.fac.len() > n {
	            return;
	        }
	
	        let old_len = self.fac.len();
	        let target = n.max(old_len.saturating_mul(2));
	
	        assert!(
	            target < usize::MAX,
	            "factorial table size overflow"
	        );
	
	        self.fac.resize(target + 1, 0.m());
	        self.ifac.resize(target + 1, 0.m());
	
	        for i in old_len..=target {
	            self.fac[i] = self.fac[i - 1] * i.m();
	        }
	
	        self.ifac[target] = 1.m() / self.fac[target];
	
	        for i in (old_len..target).rev() {
	            self.ifac[i] = self.ifac[i + 1] * (i + 1).m();
	        }
	    }
	
	    // n!
	    pub fn factorial(&mut self, n: usize) -> Mint {
	        self.ensure(n);
	        self.fac[n]
	    }
	
	    // 1 / n!
	    pub fn inv_factorial(&mut self, n: usize) -> Mint {
	        self.ensure(n);
	        self.ifac[n]
	    }
	
	    // P(n, k)
	    pub fn perm(&mut self, n: usize, k: usize) -> Mint {
	        if n < k {
	            return 0.m();
	        }
	
	        self.ensure(n);
	        self.fac[n] * self.ifac[n - k]
	    }
	
	    // C(n, k)
	    pub fn comb(&mut self, n: usize, k: usize) -> Mint {
	        if n < k {
	            return 0.m();
	        }
	
	        self.ensure(n);
	        self.fac[n] * self.ifac[k] * self.ifac[n - k]
	    }
	
	    // H(n, k)
	    pub fn multichoose(&mut self, n: usize, k: usize) -> Mint {
	        if n == 0 {
	            return if k == 0 {
	                1.m()
	            } else {
	                0.m()
	            };
	        }
	
	        let total = n
	            .checked_add(k)
	            .and_then(|x| x.checked_sub(1))
	            .expect("multichoose argument overflow");
	
	        self.comb(total, k)
	    }
	}
	
snippet snreindexedges
	fn reindex_edges(n: usize, es: &Vec<(usize, usize)>, root: usize)
	        -> (Vec<usize>, Vec<usize>) {
	    let es = es.iit()
	        .enumerate()
	        .map(|(i,(u,v))| (u, v, i))
	        .colv();
	    let g = graph!(n, &es, undirected, weighted);
	
	    let mut e2i = vec![0; n-1];
	    let mut i2e = vec![usize::MAX; n];
	
	    fn dfs(
	        v: usize,
	        par: usize,
	        g: &WGraph<usize>,
	        e2i: &mut Vec<usize>, 
	        i2e: &mut Vec<usize>,
	    ) {
	        for &(u, e) in &g[v] {
	            if u == par {
	                continue;
	            }
	            e2i[e] = u;
	            i2e[u] = e;
	            dfs(u, v, g, e2i, i2e);
	        }
	    }
	
	    dfs(root, usize::MAX, &g, &mut e2i, &mut i2e);
	
	    (e2i, i2e)
	}
	
snippet snhld
	#[derive(Clone, Debug, PartialEq, Eq)]
	struct PathSegment {
	    range: Range<usize>,
	    reversed: bool,
	}
	
	struct Hld {
	    n: usize,
	    root: usize,
	    graph: Vec<Vec<usize>>,
	
	    parent: Vec<usize>,
	    depth: Vec<usize>,
	    subtree_size: Vec<usize>,
	    heavy: Vec<usize>,
	
	    head: Vec<usize>,
	    pos: Vec<usize>,
	    vertex_at: Vec<usize>,
	
	    tin: Vec<usize>,
	    tout: Vec<usize>,
	}
	
	impl Hld {
	    fn new(graph: Vec<Vec<usize>>, root: usize) -> Self {
	        let n = graph.len();
	        assert!(n > 0, "tree must not be empty");
	        assert!(root < n, "root is out of range");
	        assert_eq!(
	            graph.iter().map(Vec::len).sum::<usize>(),
	            2 * (n - 1),
	            "graph must be an undirected tree"
	        );
	
	        let none = usize::MAX;
	        let mut parent = vec![none; n];
	        let mut depth = vec![0usize; n];
	        let mut order = Vec::with_capacity(n);
	        let mut stack = vec![root];
	        parent[root] = root;
	
	        // Iterative DFS to establish parent/depth and a traversal order.
	        while let Some(v) = stack.pop() {
	            order.push(v);
	            for &to in graph[v].iter().rev() {
	                if parent[to] == none {
	                    parent[to] = v;
	                    depth[to] = depth[v] + 1;
	                    stack.push(to);
	                }
	            }
	        }
	        assert_eq!(order.len(), n, "graph must be connected");
	
	        // Subtree sizes and heavy children, in reverse DFS order.
	        let mut subtree_size = vec![1usize; n];
	        let mut heavy = vec![none; n];
	        for &v in order.iter().rev() {
	            if v == root {
	                continue;
	            }
	            let p = parent[v];
	            subtree_size[p] += subtree_size[v];
	            if heavy[p] == none || subtree_size[v] > subtree_size[heavy[p]] {
	                heavy[p] = v;
	            }
	        }
	
	        // Heavy-first DFS numbering.
	        let mut head = vec![0usize; n];
	        let mut pos = vec![0usize; n];
	        let mut vertex_at = vec![0usize; n];
	        let mut timer = 0usize;
	        let mut stack = vec![root];
	
	        while let Some(chain_head) = stack.pop() {
	            let mut v = chain_head;
	            loop {
	                head[v] = chain_head;
	                pos[v] = timer;
	                vertex_at[timer] = v;
	                timer += 1;
	
	                for &to in &graph[v] {
	                    if parent[to] == v && to != heavy[v] {
	                        stack.push(to);
	                    }
	                }
	
	                if heavy[v] == none {
	                    break;
	                }
	                v = heavy[v];
	            }
	        }
	
	        let tin = pos.clone();
	        let mut tout = vec![0usize; n];
	        for v in 0..n {
	            tout[v] = tin[v] + subtree_size[v];
	        }
	
	        Self {
	            n,
	            root,
	            graph,
	            parent,
	            depth,
	            subtree_size,
	            heavy,
	            head,
	            pos,
	            vertex_at,
	            tin,
	            tout,
	        }
	    }
	
	    fn subtree_range(&self, v: usize) -> Range<usize> {
	        self.tin[v]..self.tout[v]
	    }
	
	    fn is_ancestor(&self, u: usize, v: usize) -> bool {
	        self.tin[u] <= self.tin[v] && self.tin[v] < self.tout[u]
	    }
	
	    fn level_ancestor(&self, mut v: usize, k: usize) -> Option<usize> {
	        if k > self.depth[v] {
	            return None;
	        }
	        while self.depth[self.head[v]] > k {
	            v = self.parent[self.head[v]];
	        }
	        v = self.vertex_at[self.pos[v] - (self.depth[v] - k)];
	        Some(v)
	    }
	
	    fn lca(&self, mut u: usize, mut v: usize) -> usize {
	        while self.head[u] != self.head[v] {
	            if self.pos[u] > self.pos[v] {
	                swap!(&mut u, &mut v);
	            }
	            v = self.parent[self.head[v]];
	        }
	        if self.pos[u] < self.pos[v] { u } else { v }
	    }

	    fn distance(&self, u: usize, v: usize) -> usize {
	        let w = self.lca(u, v);
	        self.depth[u] + self.depth[v] - 2 * self.depth[w]
	    }
	
	    fn jump_on_tree(&self, u: usize, v: usize, k: usize) -> Option<usize> {
	        let w = self.lca(u, v);
	        let dist = self.depth[u] + self.depth[v] - 2*self.depth[w];
	        if dist < k {
	            return None;
	        }
	        if k < self.depth[u] - self.depth[w] {
	            return self.level_ancestor(u, self.depth[u] - k);
	        }
	        self.level_ancestor(v, self.depth[v] - (dist - k))
	    }
	
	    fn path_segments(&self, mut u: usize, mut v: usize) -> Vec<PathSegment> {
	        let w = self.lca(u, v);
	
	        let mut left = vec![];
	        while self.head[u] != self.head[w] {
	            left.push(PathSegment {
	                range: self.pos[self.head[u]]..self.pos[u] + 1,
	                reversed: true,
	            });
	            u = self.parent[self.head[u]];
	        }
	
	        let mut right = vec![];
	        while self.head[v] != self.head[w] {
	            right.push(PathSegment {
	                range: self.pos[self.head[v]]..self.pos[v] + 1,
	                reversed: false,
	            });
	            v = self.parent[self.head[v]];
	        }
	
	        if self.depth[u] >= self.depth[v] {
	            left.push(PathSegment {
	                range: self.pos[v]..self.pos[u] + 1,
	                reversed: true,
	            });
	        }
	        else {
	            right.push(PathSegment {
	                range: self.pos[u]..self.pos[v] + 1,
	                reversed: false,
	            });
	        }
	
	        right.reverse();
	        left.extend(right);
	        left
	    }
	
	    fn path_segments_edges(&self, u: usize, v: usize) -> Vec<PathSegment> {
	        let lca_pos = self.pos[self.lca(u, v)];
	        let mut result = vec![];
	        for mut segment in self.path_segments(u, v) {
	            if segment.range.start <= lca_pos && lca_pos < segment.range.end {
	                if segment.range.start == lca_pos {
	                    segment.range.start += 1;
	                }
	                else {
	                    segment.range.end -= 1;
	                }
	            }
	            if segment.range.start < segment.range.end {
	                result.push(segment);
	            }
	        }
	        result
	    }
	
	    fn fold_path<M, F>(&self, u: usize, v: usize, mut range_prod: F) -> M::S
	    where
	        M: Monoid,
	        F: FnMut(Range<usize>, bool) -> M::S,
	    {
	        let mut answer = M::identity();
	        for segment in self.path_segments(u, v) {
	            let value = range_prod(segment.range, segment.reversed);
	            answer = M::binary_operation(&answer, &value);
	        }
	        answer
	    }
	
	    fn fold_path_edges<M, F>(&self, u: usize, v: usize, mut range_prod: F) -> M::S
	    where
	        M: Monoid,
	        F: FnMut(Range<usize>, bool) -> M::S,
	    {
	        let mut answer = M::identity();
	        for segment in self.path_segments_edges(u, v) {
	            let value = range_prod(segment.range, segment.reversed);
	            answer = M::binary_operation(&answer, &value);
	        }
	        answer
	    }
	}
	

	#![allow(dead_code, unused_imports, unused_macros)]
	
	#[macro_use]
	mod matajupilib {
	    use crate::*;
	
	    // =============================================================================
	    // Macros
	    // =============================================================================
	    macro_rules! chmin {
	        (\$a:expr, \$b:expr) => {
	            if \$b < \$a {
	                \$a = \$b;
	                true
	            } else {
	                false
	            }
	        };
	    }
	
	    macro_rules! chmax {
	        (\$a:expr, \$b:expr) => {
	            if \$b > \$a {
	                \$a = \$b;
	                true
	            } else {
	                false
	            }
	        };
	    }

	    macro_rules! r {
	        ($num:expr, $den:expr) => {
	            Rational64::new($num, $den)
	        };
	    }
	
	    /// Debug print macro (Only works in Debug builds; ignored in Release builds)
	    macro_rules! d {
	        (\$(\$a:expr),* \$(,)?) => {
	            #[cfg(debug_assertions)]
	            eprintln!(concat!(\$(stringify!(\$a), " = {:?}, "),*), \$(\$a),*);
	        };
	    }
	
	    // =============================================================================
	    // Constants & Type Aliases
	    // =============================================================================
	    pub const IINF: i64 = 4_000_000_000_000_000_000;
	    pub const UINF: usize = 1_000_000_000;
	
	    pub const DX4: [i64; 4] = [1, 0, -1, 0];
	    pub const DY4: [i64; 4] = [0, 1, 0, -1];
	    pub const DX8: [i64; 8] = [1, 1, 0, -1, -1, -1, 0, 1];
	    pub const DY8: [i64; 8] = [0, 1, 1, 1, 0, -1, -1, -1];
	
	    pub type MinHeap<T> = BinaryHeap<R<T>>;
	    pub type MaxHeap<T> = BinaryHeap<T>;
	
	    // =============================================================================
	    // Type Cast Traits
	    // =============================================================================
	    macro_rules! define_cast_trait {
	        (\$trait_name:ident, \$fn_name:ident, \$target_type:ty, \$(\$source_type:ty),*) => {
	            pub trait \$trait_name {
	                fn \$fn_name(self) -> \$target_type;
	            }
	            \$(
	                impl \$trait_name for \$source_type {
	                    #[inline]
	                    fn \$fn_name(self) -> \$target_type { self as \$target_type }
	                }
	            )*
	        };
	    }
	
	    define_cast_trait!(
	        AsUsize, u, usize, i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, char,
	        f32, f64
	    );
	    define_cast_trait!(
	        AsI64, i, i64, i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, char, f32,
	        f64
	    );
	    define_cast_trait!(
	        AsF64, f, f64, i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, f32, f64
	    );
	
	    pub trait AsMint {
	        fn m(self) -> Mint;
	    }
	
	    impl<T> AsMint for T
	    where
	        T: Into<Mint>,
	    {
	        #[inline]
	        fn m(self) -> Mint {
	            self.into()
	        }
	    }
	
	    // =============================================================================
	    // Helper Traits
	    // =============================================================================
	    pub trait Unwrapper<T> {
	        fn uw(self) -> T;
	        fn uwor(self, default: T) -> T;
	        fn uworelse<F>(self, f: F) -> T
	        where
	            F: FnOnce() -> T;
	    }
	
	    impl<T> Unwrapper<T> for Option<T> {
	        #[inline]
	        fn uw(self) -> T {
	            self.expect("None value")
	        }
	        #[inline]
	        fn uwor(self, default: T) -> T {
	            self.unwrap_or(default)
	        }
	        #[inline]
	        fn uworelse<F>(self, f: F) -> T
	        where
	            F: FnOnce() -> T,
	        {
	            self.unwrap_or_else(f)
	        }
	    }
	
	    impl<T, E: std::fmt::Debug> Unwrapper<T> for Result<T, E> {
	        #[inline]
	        fn uw(self) -> T {
	            self.expect("Err value")
	        }
	        #[inline]
	        fn uwor(self, default: T) -> T {
	            self.unwrap_or(default)
	        }
	        #[inline]
	        fn uworelse<F>(self, f: F) -> T
	        where
	            F: FnOnce() -> T,
	        {
	            self.unwrap_or_else(|_| f())
	        }
	    }
	
	    pub trait ShortNumOps: Sized {
	        fn sadd(self, rhs: Self) -> Self;
	        fn ssub(self, rhs: Self) -> Self;
	        fn smul(self, rhs: Self) -> Self;
	        fn oadd(self, rhs: Self) -> (Self, bool);
	        fn osub(self, rhs: Self) -> (Self, bool);
	        fn omul(self, rhs: Self) -> (Self, bool);
	    }
	
	    macro_rules! impl_short_num_ops {
	        (\$(\$t:ty),*) => { \$(
	            impl ShortNumOps for \$t {
	                #[inline] fn sadd(self, rhs: Self) -> Self { self.saturating_add(rhs) }
	                #[inline] fn ssub(self, rhs: Self) -> Self { self.saturating_sub(rhs) }
	                #[inline] fn smul(self, rhs: Self) -> Self { self.saturating_mul(rhs) }
	                #[inline] fn oadd(self, rhs: Self) -> (Self, bool) { self.overflowing_add(rhs) }
	                #[inline] fn osub(self, rhs: Self) -> (Self, bool) { self.overflowing_sub(rhs) }
	                #[inline] fn omul(self, rhs: Self) -> (Self, bool) { self.overflowing_mul(rhs) }
	            }
	        )* };
	    }
	    impl_short_num_ops!(
	        i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize
	    );
	
	    pub trait MapExt<K, V> {
	        fn orins(&mut self, key: K, default: V) -> &mut V;
	        fn ordef(&mut self, key: K) -> &mut V
	        where
	            V: Default;
	        fn orwith<F: FnOnce() -> V>(&mut self, key: K, f: F) -> &mut V;
	    }
	
	    impl<K: Eq + Hash, V, S: BuildHasher> MapExt<K, V> for HashMap<K, V, S> {
	        #[inline]
	        fn orins(&mut self, key: K, default: V) -> &mut V {
	            self.entry(key).or_insert(default)
	        }
	        #[inline]
	        fn ordef(&mut self, key: K) -> &mut V
	        where
	            V: Default,
	        {
	            self.entry(key).or_default()
	        }
	        #[inline]
	        fn orwith<F: FnOnce() -> V>(&mut self, key: K, f: F) -> &mut V {
	            self.entry(key).or_insert_with(f)
	        }
	    }
	
	    impl<K: Ord, V> MapExt<K, V> for BTreeMap<K, V> {
	        #[inline]
	        fn orins(&mut self, key: K, default: V) -> &mut V {
	            self.entry(key).or_insert(default)
	        }
	        #[inline]
	        fn ordef(&mut self, key: K) -> &mut V
	        where
	            V: Default,
	        {
	            self.entry(key).or_default()
	        }
	        #[inline]
	        fn orwith<F: FnOnce() -> V>(&mut self, key: K, f: F) -> &mut V {
	            self.entry(key).or_insert_with(f)
	        }
	    }
	
	    pub trait StrExt {
	        fn cv(&self) -> Vec<char>;
	    }
	
	    impl StrExt for str {
	        #[inline]
	        fn cv(&self) -> Vec<char> {
	            self.chars().collect()
	        }
	    }
	
	    // =============================================================================
	    // Iterator Extensions
	    // =============================================================================
	    pub trait IntoIterExt: IntoIterator + Sized {
	        #[inline]
	        fn iit(self) -> Self::IntoIter {
	            self.into_iter()
	        }
	        #[inline]
	        fn col<B: FromIterator<Self::Item>>(self) -> B {
	            self.into_iter().collect()
	        }
	        #[inline]
	        fn colv(self) -> Vec<Self::Item> {
	            self.into_iter().collect()
	        }
	    }
	    impl<T: IntoIterator> IntoIterExt for T {}
	
	    pub trait IterExt {
	        #[inline]
	        fn it(&self) -> <&Self as IntoIterator>::IntoIter
	        where
	            for<'a> &'a Self: IntoIterator,
	        {
	            self.into_iter()
	        }
	        #[inline]
	        fn itm(&mut self) -> <&mut Self as IntoIterator>::IntoIter
	        where
	            for<'a> &'a mut Self: IntoIterator,
	        {
	            self.into_iter()
	        }
	    }
	    impl<T: ?Sized> IterExt for T {}
	}
	

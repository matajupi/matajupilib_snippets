	    }
	    fn mapping(f: &Self::F, x: &<Self::M as Monoid>::S) -> <Self::M as Monoid>::S {
	        *f + *x
	    }
	    fn composition(f: &Self::F, g: &Self::F) -> Self::F {
	        *f + *g
	    }
	}

snippet snsumsize
	#[derive(Clone, Copy, Debug)]
	struct SumSize {
	    sum: i64,
	    size: usize,
	}
	
	impl SumSize {
	    fn new(sum: i64) -> Self {
	        Self { sum: sum, size: 1 }
	    }
	}
	
	struct SumMonoid;
	impl Monoid for SumMonoid {
	    type S = SumSize;
	    fn identity() -> Self::S {
	        SumSize { sum: 0, size: 0 }
	    }
	    fn binary_operation(a: &Self::S, b: &Self::S) -> Self::S {
	        SumSize {
	            sum: a.sum + b.sum,
	            size: a.size + b.size,
	        }
	    }
	}

snippet snrangeaddrangesum
	// M1 = ((i64, usize), (+,+), (0, 0))
	// M2 = (i64, +, 0)
	// f_x((a, b)) = (a+x*b, b)
	// f_x((a, b)+(c, d)) = (a+c+x*(b+d), b+d) = ((a+x*b)+(c+x*d), b+d) = f_x((a, b)) + f_x((c, d))
	// f_{x+y}((a, b)) = (a+x*b+y*b, b) = f_x(f_y((a, b)))
	struct RangeAddRangeSum;
	impl MapMonoid for RangeAddRangeSum {
	    type M = SumMonoid;
	    type F = i64;
	    fn identity_map() -> Self::F {
	        0
	    }
	    fn mapping(f: &Self::F, x: &<Self::M as Monoid>::S) -> <Self::M as Monoid>::S {
	        SumSize {
	            sum: x.sum + (*f * x.size as i64),
	            size: x.size,
	        }
	    }
	    fn composition(f: &Self::F, g: &Self::F) -> Self::F {
	        *f + *g
	    }
	}

snippet snrangesetrangemin
	// M1 = (i64, min, inf)
	// M2 = (Option<i64>, or, None)
	// f_x(a) = x.uor(a) (uor = unwrap_or)
	// f_x(min(a,b)) = x.uor(min(a,b)) = min(x.uor(a), x.uor(b)) = min(f_x(a), f_x(b))
	// f_{x.or(y)}(a) = (x.or(y)).uor(a) = x.uor(y.uor(a)) = f_x(f_y(a))
	struct RangeSetRangeMin;
	impl MapMonoid for RangeSetRangeMin {
	    type M = Min<i64>;
	    type F = Option<<Self::M as Monoid>::S>;
	    fn identity_map() -> Self::F {
	        None
	    }
	    fn mapping(f: &Self::F, x: &<Self::M as Monoid>::S) -> <Self::M as Monoid>::S {
	        f.unwrap_or(*x)
	    }
	    fn composition(f: &Self::F, g: &Self::F) -> Self::F {
	        f.or(*g)
	    }
	}

snippet snrangesetrangemax
	// M1 = (i64, max, -inf)
	// M2 = (Option<i64>, or, None)
	// f_x(a) = x.uor(a) (uor = unwrap_or)
	// f_x(max(a,b)) = x.uor(max(a,b)) = max(x.uor(a), x.uor(b)) = max(f_x(a), f_x(b))
	// f_{x.or(y)}(a) = (x.or(y)).uor(a) = x.uor(y.uor(a)) = f_x(f_y(a))
	struct RangeSetRangeMax;

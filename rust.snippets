	// f_x(a) = a + x
	// f_x(max(a,b)) = max(a,b) + x = max(a+x, b+x) = max(f_x(a), f_x(b))
	// f_{x+y}(a) = a + x + y = f_x(f_y(a))
	struct RangeAddRangeMax;
	impl MapMonoid for RangeAddRangeMax {
	    type M = Max<i64>;
	    type F = <Self::M as Monoid>::S;
	    fn identity_map() -> Self::F {

snippet snneighbor
	use num::Num;
	
	fn neighbor4<T>(x: T, y: T, w: T, h: T) -> Vec<(T, T)>
	where
	    T: Copy + PartialOrd + Num,
	{
	    let zero = T::zero();
	    let one = T::one();
	    let neg = T::zero() - T::one();
	    let dirs = [
	        (one, zero), (neg, zero),
	        (zero, one), (zero, neg),
	    ];
	    dirs
	        .into_iter()
	        .map(|(dx, dy)| (x + dx, y + dy))
	        .filter(|&(nx, ny)| zero <= nx && nx < w && zero <= ny && ny < h)
	        .collect()
	}
	
	fn neighbor8<T>(x: T, y: T, w: T, h: T) -> Vec<(T, T)>
	where
	    T: Copy + PartialOrd + Num,
	{
	    let zero = T::zero();
	    let one = T::one();
	    let neg = T::zero() - T::one();
	    let dirs = [
	        (one, one), (one, zero), (one, neg), (zero, one),
	        (zero, neg), (neg, one), (neg, zero), (neg, neg),
	    ];
	    dirs
	        .into_iter()
	        .map(|(dx, dy)| (x + dx, y + dy))
	        .filter(|&(nx, ny)| zero <= nx && nx < w && zero <= ny && ny < h)
	        .collect()
	}

snippet snmatrix
	use ndarray::{array, Array2};
	
	fn mat_dot<R: Semiring>(lhs: &Array2<R::S>, rhs: &Array2<R::S>) -> Array2<R::S> {
	    let (r1, c1) = lhs.dim();
	    let (r2, c2) = rhs.dim();
	    if c1 != r2 {
	        panic!("illegal dimension: ({}, {}), ({}, {})", r1, c1, r2, c2);
	    }
	
	    let zero = R::add_identity();
	    let mut res = Array2::from_elem((r1, c2), zero);
	
	    for i in 0..r1 {
	        for k in 0..r2 {
	            for j in 0..c2 {
	                let term = R::mul(&lhs[[i, k]], &rhs[[k, j]]);
	                let current = res[[i, j]].clone();
	                res[[i, j]] = R::add(&current, &term);
	            }
	        }
	    }
	    res
	}
	
	fn mat_pow<R: Semiring>(mat: &Array2<R::S>, n: u64) -> Array2<R::S> {
	    let mut mat = mat.clone();
	    let mut n = n;
	
	    let (r, c) = mat.dim();
	    if r != c {
	        panic!("illegal dimension: ({}, {})", r, c);
	    }
	
	    let zero = R::add_identity();
	    let one = R::mul_identity();
	
	    let mut res = Array2::from_elem((r, c), zero);
	    for i in 0..r {
	        res[[i, i]] = one.clone();
	    }
	
	    while n > 0 {
	        if n & 1 != 0 {
	            res = mat_dot::<R>(&res, &mat);
	        }
	        mat = mat_dot::<R>(&mat, &mat);
	        n >>= 1;
	    }
	    res
	}
	
snippet snmath
	fn enum_primes(n: u32) -> Vec<u32> {
	    let mut primes = vec![];
	    if n < 2 {
	        return primes;
	    }
	
	    let mut sieve = vec![true; (n + 1).u()];
	    sieve[0] = false;
	    sieve[1] = false;
	
	    let mut p = 1;
	    while p * p <= n {
	        if sieve[p.u()] {
	            for q in (p * p..=n).step_by(p.u()) {
	                sieve[q.u()] = false;
	            }
	        }
	        p += 1;
	    }
	    for p in 2..=n {
	        if sieve[p.u()] {
	            primes.push(p);
	        }
	    }
	
	    primes
	}

snippet sngraph
	type WGraph<T> = Vec<Vec<(usize, T)>>;
	type UGraph = Vec<Vec<usize>>;

	macro_rules! graph {
	    (\$n:expr, \$es:expr, directed, weighted) => {{
	        let mut g = vec![vec![]; \$n.u()];
	        for &(u, v, w) in \$es {
	            g[u.u()].push((v.u(), w));
	        }
	        g
	    }};
	    (\$n:expr, \$es:expr, directed, unweighted) => {{
	        let mut g = vec![vec![]; \$n.u()];
	        for &(u, v) in \$es {
	            g[u.u()].push(v.u());
	        }
	        g
	    }};
	    (\$n:expr, \$es:expr, undirected, weighted) => {{
	        let mut g = vec![vec![]; \$n.u()];
	        for &(u, v, w) in \$es {
	            g[u.u()].push((v.u(), w));
	            g[v.u()].push((u.u(), w));
	        }
	        g
	    }};
	    (\$n:expr, \$es:expr, undirected, unweighted) => {{
	        let mut g = vec![vec![]; \$n.u()];
	        for &(u, v) in \$es {
	            g[u.u()].push(v.u());
	            g[v.u()].push(u.u());
	        }
	        g
	    }};
	}

snippet sncmprs
	use std::hash::Hash;
	
	fn coord_compress<T>(src: &[T]) -> (HashMap<T, usize>, Vec<T>)
	where
	    T: Ord + Clone + Hash,
	{
	    let src_iter = src
	        .iter()
	        .cloned()
	        .sorted()
	        .dedup();
	    let i2v = src_iter
	        .clone()
	        .collect::<Vec<_>>();
	    let v2i = src_iter
	        .enumerate()
	        .map(|(i, x)| (x, i))
	        .collect::<HashMap<_, _>>();
	    (v2i, i2v)
	}

snippet snfactorize
	fn factorize(mut n: i64, pfs: &mut HashMap<i64, usize>) {
	    let mut p = 2;
	    while p*p <= n {
	        let mut e = 0;
	        while n % p == 0 {
	            n /= p;
	            e += 1;
	        }
	        if e > 0 {
	            *pfs.entry(p).or_insert(0) += e;
	        }
	        p += 1;
	    }
	    if n != 1 {
	        *pfs.entry(n).or_insert(0) += 1;
	    }
	}
	

snippet snrollinghash
	use std::ops::{Bound, RangeBounds};
	
	#[derive(Debug, Clone)]
	struct RollingHash {
	    n: usize,
	    b: u128,
	    m: u128,
	    prefix: Vec<u128>,
	    suffix: Vec<u128>,
	    power: Vec<u128>,
	}
	
	impl RollingHash {
	    // 2 <= b < m, gcd(b, m) = 1
	    // e.g. b = 2025, m = 998244353
	    fn new<T>(s: &[T], b: u128, m: u128) -> Self
	    where
	        T: Into<u128> + Copy
	    {
	        let n = s.len();
	
	        let mut prefix = vec![0u128; n+1];
	        let mut suffix = vec![0u128; n+1];
	        let mut power = vec![1u128; n+1];
	
	        for i in 0..n {
	            let val_fwd: u128 = s[i].into();
	            let val_rev: u128 = s[n-i-1].into();
	
	            prefix[i+1] = ((prefix[i]*b)%m + val_fwd)%m;
	            suffix[i+1] = ((suffix[i]*b)%m + val_rev)%m;
	            power[i+1] = (power[i]*b)%m;
	        }
	
	        Self {
	            n, b, m,
	            prefix,
	            suffix,
	            power,
	        }
	    }
	
	    fn get_range<R>(&self, range: R, rev: bool) -> (usize, usize)
	    where
	        R: RangeBounds<usize>
	    {
	        let l = match range.start_bound() {
	            Bound::Included(l) => *l,
	            Bound::Excluded(l) => l + 1,
	            Bound::Unbounded => 0,
	        };
	        let r = match range.end_bound() {
	            Bound::Included(r) => r + 1,
	            Bound::Excluded(r) => *r,
	            Bound::Unbounded => self.n,
	        };
	
	        assert!(l <= r && r <= self.n, "Index out of bounds");
	
	        if rev {
	            (self.n - r, self.n - l)
	        }
	        else {
	            (l, r)
	        }
	    }
	
	    // H(S[range])
	    fn hash<R>(&self, range: R, rev: bool) -> u128
	    where
	        R: RangeBounds<usize>
	    {
	        let (l, r) = self.get_range(range, rev);
	        let seq = if rev { &self.suffix } else { &self.prefix };
	        self.hash_helper(l, r, seq)
	    }
	
	    fn hash_helper(&self, l: usize ,r: usize, seq: &Vec<u128>) -> u128 {
	        (self.m + seq[r] - (self.power[r-l]*seq[l])%self.m)%self.m
	    }
	
	    // H(S1 + S2) (l2 = |S2|)
	    fn concat(&self, h1: u128, h2: u128, l2: usize) -> u128 {
	        ((self.power[l2]*h1)%self.m + h2)%self.m
	    }
	
	    // LCP(S[range1], S[range2])
	    fn lcp<R1, R2>(&self, range1: R1, rev1: bool, range2: R2, rev2: bool) -> usize
	    where
	        R1: RangeBounds<usize>,
	        R2: RangeBounds<usize>,
	    {
	        let (l1, r1) = self.get_range(range1, rev1);
	        let (l2, r2) = self.get_range(range2, rev2);
	
	        let seq1 = if rev1 { &self.suffix } else { &self.prefix };
	        let seq2 = if rev2 { &self.suffix } else { &self.prefix };
	
	        let mut lb = 0;
	        let mut ub = min(r1 - l1, r2 - l2) + 1;
	        while ub - lb > 1 {
	            let mid = (ub + lb) / 2;
	            if self.hash_helper(l1, l1+mid, seq1) == self.hash_helper(l2, l2+mid, seq2) {
	                lb = mid;
	            }
	            else {
	                ub = mid;
	            }
	        }
	        lb
	    }
	}

snippet snrangeaddrangemin
	// M1 = (i64, min, inf)
	// M2 = (i64, +, 0)
	// f_x(a) = a + x
	// f_x(min(a,b)) = min(a,b) + x = min(a+x, b+x) = min(f_x(a), f_x(b))
	// f_{x+y}(a) = a + x + y = f_x(f_y(a))
	struct RangeAddRangeMin;
	impl MapMonoid for RangeAddRangeMin {
	    type M = Min<i64>;
	    type F = <Self::M as Monoid>::S;
	    fn identity_map() -> Self::F {
	        0
	    }
	    fn mapping(f: &Self::F, x: &<Self::M as Monoid>::S) -> <Self::M as Monoid>::S {
	        *f + *x
	    }
	    fn composition(f: &Self::F, g: &Self::F) -> Self::F {
	        *f + *g
	    }
	}


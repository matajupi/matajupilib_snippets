snippet snscanner
	use std::io::Read;
	
	struct Scanner {
	    iter: std::vec::IntoIter<String>,
	}
	
	impl Scanner {
	    fn new() -> Self {
	        let mut s = String::new();
	        std::io::stdin().read_to_string(&mut s).unwrap();
	        Self {
	            iter: s.split_whitespace().map(|s| s.to_string()).collect::<Vec<_>>().into_iter(),
	        }
	    }
	    fn n<T: std::str::FromStr>(&mut self) -> T {
	        self.iter.next().unwrap().parse().ok().unwrap()
	    }
	    fn ns<T: std::str::FromStr>(&mut self, n: usize) -> Vec<T> {
	        (0..n).map(|_| self.n()).collect()
	    }
	}

snippet sntoposort
	fn topological_sort(g: &UGraph) -> Option<Vec<usize>> {
	    let n = g.len();
	    let mut indeg = vec![0; n];
	    for u in 0..n {
	        for &v in &g[u] {
	            indeg[v] += 1;
	        }
	    }
	
	    let mut que = VecDeque::new();
	    for u in 0..n {
	        if indeg[u] == 0 {
	            que.push_front(u);
	        }
	    }
	    let mut topo_order = vec![];
	
	    while !que.is_empty() {
	        let u = que.pop_front().uw();
	        topo_order.push(u);
	        for &v in &g[u] {
	            indeg[v] -= 1;
	            if indeg[v] == 0 {
	                que.push_back(v);
	            }
	        }
	    }
	
	    if topo_order.len() == n {
	        Some(topo_order)
	    }
	    else {
	        None
	    }
	}

snippet sndijkstra
	fn dijkstra(g: &WGraph<i64>, start: usize) -> Vec<i64> {
	    let n = g.len();
	    let mut dist = vec![i64::MAX; n];
	    let mut que = BinaryHeap::new();
	    dist[start] = 0;
	    que.push(Reverse((dist[start], start)));
	
	    while !que.is_empty() {
	        let Reverse((d, u)) = que.pop().uw();
	        if dist[u] < d {
	            continue;
	        }
	        for &(v, c) in &g[u] {
	            if chmin!(dist[v], dist[u] + c) {
	                que.push(Reverse((dist[v], v)));
	            }
	        }
	    }
	
	    dist
	}

snippet snscc
	fn scc_graph(g: &UGraph) -> (UGraph, Vec<usize>, Vec<Vec<usize>>) {
	    let n = g.len();
	    let mut sccg = SccGraph::new(n);
	    for u in 0..n {
	        for &v in &g[u] {
	            sccg.add_edge(u, v);
	        }
	    }
	
	    let sccs = sccg.scc();
	    let m = sccs.len();
	
	    let mut to_scc = vec![0; n];
	    for i in 0..m {
	        for &u in &sccs[i] {
	            to_scc[u] = i;
	        }
	    }
	
	    let mut uv_scc = set!{};
	    for u in 0..n {
	        for &v in &g[u] {
	            let u = to_scc[u];
	            let v = to_scc[v];
	            if u == v {
	                continue;
	            }
	            uv_scc.insert((u, v));
	        }
	    }
	    let uv_scc = uv_scc.into_iter()
	        .collect_vec();
	    let g_scc = graph!(m, &uv_scc, directed, unweighted);
	
	    (g_scc, to_scc, sccs)
	}
	
snippet snsemiring
	trait Semiring {
	    type S: Clone;
	    fn add_identity() -> Self::S;
	    fn add(a: &Self::S, b: &Self::S) -> Self::S;
	    fn mul_identity() -> Self::S;
	    fn mul(a: &Self::S, b: &Self::S) -> Self::S;
	}
	
snippet snmodintsemiring
	struct ModIntSemiring;
	impl Semiring for ModIntSemiring {
	    type S = Mint;
	    fn add_identity() -> Self::S { Mint::new(0) }
	    fn add(a: &Self::S, b: &Self::S) -> Self::S { a + b }
	    fn mul_identity() -> Self::S { Mint::new(1) }
	    fn mul(a: &Self::S, b: &Self::S) -> Self::S { a * b }
	}
	
snippet snminplussemiring
	struct MinPlusSemiring;
	impl Semiring for MinPlusSemiring {
	    type S = i64;
	    fn add_identity() -> Self::S { i64::MAX }
	    fn add(a: &Self::S, b: &Self::S) -> Self::S { min(*a, *b) }
	    fn mul_identity() -> Self::S { 0 }
	    fn mul(a: &Self::S, b: &Self::S) -> Self::S {
	        let inf = Self::add_identity();
	        if *a >= inf || *b >= inf {
	            inf
	        }
	        else {
	            a + b
	        }
	    }
	}
	
snippet snmaxplussemiring
	struct MaxPlusSemiring;
	impl Semiring for MaxPlusSemiring {
	    type S = i64;
	    fn add_identity() -> Self::S { i64::MIN }
	    fn add(a: &Self::S, b: &Self::S) -> Self::S { max(*a, *b) }
	    fn mul_identity() -> Self::S { 0 }
	    fn mul(a: &Self::S, b: &Self::S) -> Self::S {
	        let inf = Self::add_identity();
	        if *a <= inf || *b <= inf {
	            inf
	        }
	        else {
	            a + b
	        }
	    }
	}
	
snippet snxorandsemiring
	struct XorAndSemiring;
	impl Semiring for XorAndSemiring {
	    type S = u64;
	    fn add_identity() -> Self::S { 0 }
	    fn add(a: &Self::S, b: &Self::S) -> Self::S { *a ^ *b }
	    fn mul_identity() -> Self::S { u64::MAX }
	    fn mul(a: &Self::S, b: &Self::S) -> Self::S { *a & *b }
	}
	

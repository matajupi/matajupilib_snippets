	    }
	    fn composition(f: &Self::F, g: &Self::F) -> Self::F {
	        f.or(*g)
	    }
	}

snippet snrangesetrangesum
	// M1 = ((i64, usize), (+,+), (0, 0))
	// M2 = (Option<i64>, or, None)
	// f_x((a, b)) = if x == Some(v) then (v*b, b) else (a, b)
	// f_x((a, b)+(c, d)) = (v*b+v*d, b+d) = f_x((a, b)) + f_x((c, d)) (x = Some(v))
	// f_x((a, b)+(c, d)) = (a+c, b+d) = f_x((a, b)) + f_x((c, d)) (x = None)
	// f_{x.or(y)}((a, b)) = (v*b, b) = f_x(f_y((a, b))) (x = Some(v), y = _)
	// f_{x.or(y)}((a, b)) = (v*b, b) = f_x(f_y((a, b))) (x = None, y = Some(v))
	// f_{x.or(y)}((a, b)) = (a, b) = f_x(f_y((a, b))) (x = None, y = None)
	struct RangeSetRangeSum;
	impl MapMonoid for RangeSetRangeSum {
	    type M = SumMonoid;
	    type F = Option<i64>;
	    fn identity_map() -> Self::F {
	        None
	    }
	    fn mapping(f: &Self::F, x: &<Self::M as Monoid>::S) -> <Self::M as Monoid>::S {
	        match *f {
	            Some(v) => SumSize {
	                sum: v * x.size as i64,
	                size: x.size,
	            },
	            None => *x,
	        }
	    }
	    fn composition(f: &Self::F, g: &Self::F) -> Self::F {
	        f.or(*g)
	    }
	}

snippet snrangeaffinerangesum
	// M1 = ((i64, usize), (+, +), (0, 0))
	// M2 = ((i64, i64), comp, (1, 0))
	// comp((a1, b1), (a2, b2)) = (a1*a2, a1*b2+b1)
	// f_{(a,b)}((x, y)) = (a*x + b*y, y)
	// f_{(a,b)}((x1, y1)+(x2, y2)) = (a*(x1+x2) + b*(y1+y2), y1+y2)
	//      = (a*x1+b*y1 + a*x2+b*y2, y1+y2) = f_{(a,b)}((x1, y1)) + f_{(a,b)}((x2, y2))
	// f_{comp((a1,b1),(a2,b2))}((x, y)) = (a1*a2*x + (a1*b2+b1)*y, y)
	//      = (a1*a2*x + a1*b2*y + b1*y, y) = f_{(a1,b1)}((a2*x + b2*y, y))
	//      = f_{(a1,b1)}(f_{(a2,b2)}((x, y)))
	#[derive(Clone, Copy, Debug)]
	struct Affine {
	    a: i64,
	    b: i64,
	}
	
	impl Affine {
	    fn new(a: i64, b: i64) -> Self {
	        Self { a: a, b: b }
	    }
	}
	
	struct RangeAffineRangeSum;
	impl MapMonoid for RangeAffineRangeSum {
	    type M = SumMonoid;
	    type F = Affine;
	    fn identity_map() -> Self::F {
	        Affine { a: 1, b: 0 }
	    }
	    fn mapping(f: &Self::F, x: &<Self::M as Monoid>::S) -> <Self::M as Monoid>::S {
	        SumSize {
	            sum: f.a * x.sum + f.b * (x.size as i64),
	            size: x.size,
	        }
	    }
	    fn composition(f: &Self::F, g: &Self::F) -> Self::F {
	        Affine {
	            a: f.a * g.a,
	            b: f.a * g.b + f.b,
	        }
	    }
	}

